            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <classpathScope>runtime</classpathScope>
                    <mainClass>com.chua.example.runner.ExampleRunner</mainClass>
                    <jvmArgs>
                        <jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.nio=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.io=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.util=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/sun.nio.ch=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-exports=java.base/sun.nio.ch=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-exports=java.base/java.lang.invoke=ALL-UNNAMED</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
<plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <includes>
                        <!-- SPI 框架入口 -->
                        <include>**/Example.java</include>
                        <include>**/ExampleRunner.java</include>
                        <!-- 流程编排示例 -->
                        <include>**/FlowExample.java</include>
                        <include>**/FlowEchoNode.java</include>
                         <include>**/FlowCompleteExample.java</include>
                        <!-- 辅助类 -->
                        <include>**/SimpleEngineDataSource.java</include>
                        <!-- RPC 示例（RpcExample / RpcEchoService(Impl) / RpcPayload / RpcServerMain） -->
                        <include>**/network/rpc/*.java</include>
                        <!-- 云效链式客户端示例 -->
                        <include>**/network/yunxiao/*.java</include>
                        <!-- lang.document 文档 SPI 烟雾测试 (OpenApiExportTestExample) -->
                        <include>**/lang/document/*.java</include>
                         <!-- lang.json JsonProvider 自检 (JsonProviderExampleSpi) -->
                         <include>**/lang/json/*.java</include>
                         <!-- lang.serialize Fory 序列化自检 (ForySerializerExampleSpi) -->
                         <include>**/lang/serialize/*.java</include>
                         <!-- AI 音频示例（WhisperAudioExample） -->
                         <include>**/ai/audio/*.java</include>
                         <!-- AI 视觉示例（EdgeSamExample） -->
                         <include>**/ai/vision/*.java</include>
                         <!-- AI 嵌入示例（BgeEmbeddingExample / MiniLM ...） -->
                         <include>**/ai/embedding/*.java</include>
                         <!-- AI 用量定价 SPI 示例（ExampleModelPricingProvider） -->
                         <include>**/ai/usage/*.java</include>
                        <!-- AI Proxy 聊天示例 — 排除 KimiProxyExample -->
                        <include>**/ai/chat/Qwen*.java</include>
                        <include>**/ai/chat/AiProxy*.java</include>
<!-- 集合示例（LazyExpiringListExample） -->
                        <include>**/collection/*.java</include>
                        <!-- ThreadFlow 并发示例（ThreadFlowExample / ThreadFlowExampleSpi） -->
                        <include>**/concurrent/threadflow/*.java</include>
                        <!-- 无锁队列示例（LockFreeQueueExample） -->
                        <include>**/concurrent/queue/*.java</include>
                        <!-- NIO HttpServer 示例（NioHttpServerExampleSpi + PerfReport） -->
                        <include>**/network/nio/*.java</include>
                        <include>**/network/perf/*.java</include>
                        <!-- HTTP HttpServer 示例（HttpServerExampleSpi） -->
                        <include>**/network/http/*.java</include>
                                            </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 根 pom 全局属性 skipTests=true 会跳过本模块测试，此处显式覆盖为 false 以执行 RpcExampleTest -->
                    <skipTests>false</skipTests>
                    <!-- RPC 实现（dubbo/sofa/native）在 Java 25 下需要反射穿透 -->
                    <argLine>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
