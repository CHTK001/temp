    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <classpathScope>compile</classpathScope>
                    <mainClass>com.chua.example.ai.chat.AiProxyDetectorExample</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>offset-flow-example</id>
                        <configuration>
                            <mainClass>com.chua.example.concurrent.offset.OffsetFlowExample</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>data-sink-example</id>
                        <configuration>
                            <mainClass>com.chua.example.datalake.sink.DataSinkExample</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pipeline-engine-example</id>
                        <configuration>
                            <mainClass>com.chua.example.datalake.pipeline.PipelineEngineExample</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>datalake-server-example</id>
                        <configuration>
                            <mainClass>com.chua.example.datalake.server.DatalakeServerExample</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>subscriber-example</id>
                        <configuration>
                            <mainClass>com.chua.example.datalake.subscribe.SubscriberExample</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>http-query-engine-example</id>
                        <configuration>
                            <mainClass>com.chua.example.datalake.query.HttpDatalakeQueryEngineExample</mainClass>
                        </configuration>
                    </execution>
<execution>
                <id>data-sync-example</id>
                <configuration>
                    <mainClass>com.chua.example.datasync.DataSyncExample</mainClass>
                    <arguments>
                        <argument>--type</argument>
                        <argument>direct</argument>
                    </arguments>
                    <jvmArgs>
                        <jvmArg>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.nio=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.io=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/java.util=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-opens=java.base/sun.nio.ch=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-exports=java.base/sun.nio.ch=ALL-UNNAMED</jvmArg>
                        <jvmArg>--add-exports=java.base/java.lang.invoke=ALL-UNNAMED</jvmArg>
                    </jvmArgs>
                </configuration>
            </execution>
        <execution>
        <id>ai-proxy-detector-example</id>
        <configuration>
            <mainClass>com.chua.example.ai.chat.AiProxyDetectorExample</mainClass>
        </configuration>
    </execution>
    <execution>
